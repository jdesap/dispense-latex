{
  "files.encoding": "utf8",
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.recipes": [
    {
      "name": "Compila appunti con latexmk",
      "tools": ["latexmk-appunti"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-appunti",
      "command": "latexmk",
      "args": ["-pdf", "-synctex=1", "-interaction=nonstopmode", "-halt-on-error", "-file-line-error", "-outdir=%OUTDIR%", "%DOC%"]
    }
  ],
  "latex-workshop.view.pdf.viewer": "tab",
  "files.exclude": {"**/build": true}
}
